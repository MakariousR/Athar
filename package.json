{
  "name": "athar",
  "productName": "Athar",
  "version": "1.0.0-beta.1",
  "description": "One private memory for all your AI chats: import ChatGPT, Claude and Gemini history, search it, and let a local Ollama model remember and cite it.",
  "main": "src/main/index.js",
  "author": "Makarious Robert",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "test:live": "node tests/run.js --live",
    "dist": "npm run notices && electron-builder",
    "notices": "node scripts/generate-notices.js"
  },
  "build": {
    "appId": "com.makarious.athar",
    "productName": "Athar",
    "copyright": "Copyright (c) 2026 Makarious Robert",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE.txt",
      "PRIVACY.md",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Athar"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ai": "^7.0.105",
    "ai-sdk-ollama": "^4.3.0",
    "pdf-parse": "^1.1.4",
    "zod": "^4.6.5"
  }
}
